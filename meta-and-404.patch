diff --git a/notfound-styles.css b/notfound-styles.css
new file mode 100644
index 0000000..b63966e
--- /dev/null
+++ b/notfound-styles.css
@@ -0,0 +1,37 @@
+/* ─── 404 PAGE ───────────────────────────────────────────────────────────────── */
+.notfound-container {
+  max-width: 760px;
+  width: 100%;
+  text-align: center;
+}
+
+.notfound-container .page-label { justify-content: center; }
+
+.notfound-title {
+  font-family: var(--pixel);
+  font-size: clamp(1.1rem, 2.2vw + 0.6rem, 2rem);
+  line-height: 1.6;
+  color: var(--text);
+  margin-bottom: clamp(14px, 2.4vh, 24px);
+}
+
+.notfound-text {
+  font-family: var(--mono);
+  font-size: clamp(0.8rem, 0.4vw + 0.72rem, 1rem);
+  line-height: 1.7;
+  color: var(--muted);
+  max-width: 48ch;
+  margin: 0 auto clamp(24px, 4vh, 40px);
+}
+
+.notfound-actions {
+  display: flex;
+  gap: 12px;
+  flex-wrap: wrap;
+  justify-content: center;
+}
+
+@media (max-width: 600px) {
+  .notfound-title { font-size: 0.85rem; margin-bottom: 10px; }
+  .notfound-text { font-size: 0.74rem; margin-bottom: 18px; }
+}
